{
  "name": "@scatool/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the SCA Tool Public API.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260525.1",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.22"
  }
}
